<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Client-Credentials-Flow</RootNamespace>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <UserSecretsId>e6320dce-f480-4b9f-8b5a-fe78f3eacc67</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AWSSecretsManager.Provider" Version="1.2.1.27" />
        <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.2" />
        <PackageReference Include="Azure.Identity" Version="1.21.0" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.13" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    </ItemGroup>

    <ItemGroup>
        <_ContentIncludedByDefault Remove="Client-Credential-Flow-ClientApp\obj\Client-Credential-Flow-ClientApp.csproj.nuget.dgspec.json" />
        <_ContentIncludedByDefault Remove="Client-Credential-Flow-ClientApp\obj\Debug\net10.0\Client-Credential-Flow-ClientApp.sourcelink.json" />
        <_ContentIncludedByDefault Remove="Client-Credential-Flow-ClientApp\obj\project.assets.json" />
        <_ContentIncludedByDefault Remove="Client-Credential-Flow-ClientApp\obj\project.packagespec.json" />
    </ItemGroup>

    <ItemGroup>
        <None Include="wwwroot\index.html">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
