<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Client-Credentials-Flow</RootNamespace>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <UserSecretsId>2b5cb0eb-ce6b-43d9-b8f5-08ea6316e69b</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
        <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
    </ItemGroup>

    <ItemGroup>
      <_ContentIncludedByDefault Remove="Client-Credential-Flow-ClientApp\obj\Client-Credential-Flow-ClientApp.csproj.nuget.dgspec.json" />
      <_ContentIncludedByDefault Remove="Client-Credential-Flow-ClientApp\obj\Debug\net10.0\Client-Credential-Flow-ClientApp.sourcelink.json" />
      <_ContentIncludedByDefault Remove="Client-Credential-Flow-ClientApp\obj\project.assets.json" />
      <_ContentIncludedByDefault Remove="Client-Credential-Flow-ClientApp\obj\project.packagespec.json" />
    </ItemGroup>

    <ItemGroup>
      <None Include="wwwroot\index.html">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Include="wwwroot\login.html">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
    </ItemGroup>

</Project>
